{
  "name": "dsh-matlab-bridge",
  "version": "0.1.0",
  "description": "MATLAB persistent-session bridge for DeepSeek Harness — call MATLAB as a tool without paying the 15–190 s cold start on every call.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "bridge/*.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "matlab",
    "matlab-engine",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
