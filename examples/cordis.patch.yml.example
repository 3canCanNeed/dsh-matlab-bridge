# dsh-matlab-bridge 配置示例
#
# 放到 ~/.dsh/profiles/<profile>/cordis.patch.yml 的顶层（与现有条目平级），
# 或把 - insert: 这一段合并进已有列表。
# 改完重启 DSH，工具列表里会出现 matlab_eval / matlab_run / matlab_status / matlab_stop。

- insert:
    - id: matlab-bridge
      name: dsh-matlab-bridge
      config:
        # Python 解释器路径。留空则自动探测（PATH、py -3、常见安装目录）。
        pythonPath: ""

        # server 监听端口。被占用时可以改。
        port: 8765

        # 插件激活时自动拉起 server。
        # 设为 false 时，你需要自己先跑：
        #   python bridge/matlab_mcp_server.py --http --port 8765
        autoStart: true

        # 连接一个已存在的 server（例如手动起的、或跑在别的机器上）。
        # 非空时 autoStart 不生效。
        # connectUrl: "http://127.0.0.1:8765/mcp"

        # 等待 server 就绪的超时（毫秒）。慢机器可加大。
        startupTimeoutMs: 300000

        # server 子进程的工作目录。留空 = 继承 DSH 进程的 cwd。
        # 想要 MATLAB 的 pwd 固定指向某个工程目录时，填绝对路径。
        cwd: ""

        # 工具名前缀，默认 matlab。改掉后变成 <prefix>_eval 等。
        # toolPrefix: "matlab"
